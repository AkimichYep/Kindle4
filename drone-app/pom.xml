<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.kindle</groupId>
        <artifactId>drone</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>drone-app</artifactId>
    <name>drone-app</name>
    <description>Runnable tools and main detector entry point</description>

    <dependencies>
        <dependency>
            <groupId>com.kindle</groupId>
            <artifactId>drone-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.kindle</groupId>
            <artifactId>drone-display</artifactId>
        </dependency>
        <dependency>
            <groupId>com.kindle</groupId>
            <artifactId>drone-util</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.yep.kindle.dron.KindleDroneDetectorPro</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- Bundle drone-core, drone-display, drone-util (and any other
                 dependencies) into a single runnable fat JAR so `java -jar`
                 works on the Kindle, which has no dependency management. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer
                                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.yep.kindle.dron.KindleDroneDetectorPro</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- ═══════════════════════════════════════════════════════════════════════
         GraalVM Native Image profile
         ═══════════════════════════════════════════════════════════════════════
         Activation: mvn -Pnative package

         Prerequisites:
           1. GraalVM CE 21+ (java.awt headless AWT supported since GraalVM 22)
              export JAVA_HOME=/path/to/graalvm-ce-21
              export PATH=$JAVA_HOME/bin:$PATH
           2. native-image must be on the PATH:
              gu install native-image
           3. For cross-compilation to ARM (Kindle target):
              pass -H:TargetPlatform=linux-aarch32 (ARMv7)
              or use a GraalVM distribution built for the target platform.

         The profile uses the native-maven-plugin (GraalVM official plugin).
         The META-INF/native-image/ hints directory is picked up automatically.
         ═══════════════════════════════════════════════════════════════════════ -->
    <profiles>
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <!-- Step 1: still produce the fat JAR via maven-shade-plugin
                         (used as the classpath for native-image compilation). -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>3.5.1</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals><goal>shade</goal></goals>
                                <configuration>
                                    <createDependencyReducedPom>false</createDependencyReducedPom>
                                    <transformers>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                            <mainClass>com.yep.kindle.dron.KindleDroneDetectorPro</mainClass>
                                        </transformer>
                                    </transformers>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Step 2: compile the fat JAR to a native binary. -->
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>0.10.2</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals><goal>compile-no-fork</goal></goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <!-- Name of the output binary -->
                            <imageName>drone-detector</imageName>
                            <mainClass>com.yep.kindle.dron.KindleDroneDetectorPro</mainClass>

                            <!-- Classpath: use the shaded fat JAR built above -->
                            <classpath>
                                <param>${project.build.directory}/${project.artifactId}-${project.version}.jar</param>
                            </classpath>

                            <!-- Additional native-image arguments beyond those in
                                 META-INF/native-image/native-image.properties -->
                            <buildArgs>
                                <!-- Optimise for size on the memory-constrained Kindle 4 -->
                                <buildArg>-Os</buildArg>
                                <!-- Static GC: simpler, lower overhead for single-purpose device -->
                                <buildArg>--gc=epsilon</buildArg>
                                <!-- Enable headless AWT (BufferedImage / Graphics2D / ImageIO) -->
                                <buildArg>-Djava.awt.headless=true</buildArg>
                                <!-- Embed the native image into a static executable when
                                     cross-compiling; comment out for host-arch testing. -->
                                <!-- <buildArg>-H:+StaticExecutableWithDynamicLibC</buildArg> -->
                            </buildArgs>

                            <!-- Let the native-image agent collect reflection/resource
                                 metadata automatically when running unit tests.
                                 Only relevant if tests are added in the future. -->
                            <agent>
                                <enabled>false</enabled>
                            </agent>
                        </configuration>
                    </plugin>
                </plugins>
            </build>

            <!-- GraalVM SDK BOM (brings in the correct native-maven-plugin version) -->
            <dependencyManagement>
                <dependencies>
                    <dependency>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>0.10.2</version>
                        <type>pom</type>
                        <scope>import</scope>
                    </dependency>
                </dependencies>
            </dependencyManagement>
        </profile>
    </profiles>
</project>
