<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.kindle</groupId>
        <artifactId>drone</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>drone-app</artifactId>
    <name>drone-app</name>
    <description>Runnable tools and main detector entry point</description>

    <dependencies>
        <dependency>
            <groupId>com.kindle</groupId>
            <artifactId>drone-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.kindle</groupId>
            <artifactId>drone-display</artifactId>
        </dependency>
        <dependency>
            <groupId>com.kindle</groupId>
            <artifactId>drone-util</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.yep.kindle.dron.KindleDroneDetectorPro</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- Bundle drone-core, drone-display, drone-util (and any other
                 dependencies) into a single runnable fat JAR so `java -jar`
                 works on the Kindle, which has no dependency management. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer
                                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.yep.kindle.dron.KindleDroneDetectorPro</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
